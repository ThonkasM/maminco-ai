# --- Database (read-only) -------------------------------------------------
# SQLAlchemy URL pointing at the SAME PostgreSQL database the NestJS backend
# owns. The service never writes to it.
AI_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/maminco
AI_DB_CONNECT_TIMEOUT=5

# --- Security -------------------------------------------------------------
# Shared secret expected in the X-Internal-Token header on every route except
# /health. Must match the value configured in the backend proxy.
AI_INTERNAL_SERVICE_TOKEN=change-me

# --- Observability --------------------------------------------------------
AI_LOG_LEVEL=INFO

# --- Model artifacts ------------------------------------------------------
AI_MODEL_DIR=data/models

# --- Forecasting behaviour (optional) -------------------------------------
AI_MIN_DAYS_REQUIRED=14
AI_HISTORY_DAYS=180
AI_DEFAULT_HORIZON=7
AI_MAX_HORIZON=60
AI_RANDOM_SEED=42

# --- CORS (optional, comma-separated) -------------------------------------
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
