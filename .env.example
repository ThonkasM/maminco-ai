# --- Database (read-only) -------------------------------------------------
# SQLAlchemy URL pointing at the SAME PostgreSQL database the NestJS backend
# owns. Use a SELECT-only role (docker/postgres/10-ai-readonly.sh in
# maminco-infra creates `maminco_ai`); the service never writes.
AI_DATABASE_URL=postgresql+psycopg://maminco_ai:CHANGE_ME@localhost:5432/maminco_dev
AI_DB_CONNECT_TIMEOUT=5

# --- Security (REQUIRED) --------------------------------------------------
# Shared secret expected in the X-Internal-Token header on every route except
# /health. There is no default: the service refuses to start when it is
# missing, shorter than 32 characters or a placeholder such as "change-me".
# Must equal the backend INTERNAL_SERVICE_TOKEN. Generate with:
#   openssl rand -hex 32
AI_INTERNAL_SERVICE_TOKEN=

# --- Time -----------------------------------------------------------------
# IANA time zone used to bucket orders into business days and hours. Keep it
# equal to the backend REPORT_TIMEZONE. Orders are stored in UTC.
AI_TIMEZONE=America/La_Paz

# --- Observability --------------------------------------------------------
AI_LOG_LEVEL=INFO

# --- Model artifacts ------------------------------------------------------
AI_MODEL_DIR=data/models

# --- Forecasting behaviour (optional) -------------------------------------
# Minimum days with sales before anomalies/forecasts are produced. The sales
# forecast additionally never goes below 36 days (28-day lags + training rows).
AI_MIN_DAYS_REQUIRED=14
AI_HISTORY_DAYS=180
AI_DEFAULT_HORIZON=7
AI_MAX_HORIZON=60
AI_RANDOM_SEED=42

# --- CORS (optional, comma-separated) -------------------------------------
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
